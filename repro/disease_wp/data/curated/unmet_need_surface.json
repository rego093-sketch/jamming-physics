    "curative / effectively normalizing": "curative_or_normalizing",
    "curative": "curative_or_normalizing"
  },
  "grade_carried": "burden_grade = raw_burden_grade_present (trustworthiness of the burden value); treatment_grade and residual_grade carried from the registry.",
