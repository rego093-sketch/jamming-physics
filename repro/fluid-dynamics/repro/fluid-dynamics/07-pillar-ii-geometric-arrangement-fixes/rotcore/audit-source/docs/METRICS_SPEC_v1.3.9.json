  "denominator": "r_pred",
  "metrics": {
    "MAE": "mean(|r_meas - r_pred|)",
    "MAPE_percent": "100 * mean(|r_meas - r_pred| / r_pred)",
    "rel_med_percent": "100 * median(|r_meas - r_pred| / r_pred)",
    "rel_IQR_percent": "100 * (Q3(|r_meas - r_pred| / r_pred) - Q1(|r_meas - r_pred| / r_pred))",
    "RMSE": "sqrt(mean((r_meas - r_pred)^2))",
    "NRMSE_percent": "100 * RMSE / median(r_pred)",
    "rho_spearman": "Spearman rank correlation between r_pred and r_meas",
    "coverage_10_percent": "P(|r_meas - r_pred| / r_pred <= 0.10)",
    "coverage_20_percent": "P(|r_meas - r_pred| / r_pred <= 0.20)",
    "identity_resid_percent": "100 * |N_star * r_meas^2 - phi * s * L_core^2| / (phi * s * L_core^2)",
    "R2": "1 - sum((r_meas - r_pred)^2) / sum((r_meas - mean(r_meas))^2)"
