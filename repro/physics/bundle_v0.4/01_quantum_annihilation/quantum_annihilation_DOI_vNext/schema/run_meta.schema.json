{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "run_meta",
  "type": "object",
  "required": [
    "run_id",
    "timestamp_utc",
    "machine",
    "code",
    "locks",
    "sim",
    "outputs"
  ],
  "properties": {
    "run_id": {
      "type": "string"
    },
    "timestamp_utc": {
      "type": "string"
    },
    "machine": {
      "type": "object"
    },
    "code": {
      "type": "object",
      "required": [
        "source_hash",
        "dirty_flag"
      ],
      "properties": {
        "source_hash": {
          "type": "string"
        },
        "dirty_flag": {
          "type": "boolean"
        }
      }
    },
    "locks": {
      "type": "object",
      "required": [
        "canon_lock_sha256",
        "realization_lock_sha256",
        "analysis_lock_sha256",
        "sim_lock_sha256",
        "lock_chain_sha256"
      ],
      "properties": {
        "canon_lock_sha256": {
          "type": "string"
        },
        "realization_lock_sha256": {
          "type": "string"
        },
        "analysis_lock_sha256": {
          "type": "string"
        },
        "sim_lock_sha256": {
          "type": "string"
        },
        "lock_chain_sha256": {
          "type": "string"
        }
      }
    },
    "sim": {
      "type": "object",
      "required": [
        "resolution",
        "boundary_condition",
        "dt_tick",
        "warmup_ticks",
        "total_ticks",
        "update_rule_id"
      ],
      "properties": {
        "resolution": {
          "type": "object"
        },
        "boundary_condition": {
          "type": "string"
        },
        "dt_tick": {
          "type": "number"
        },
        "warmup_ticks": {
          "type": "integer"
        },
        "total_ticks": {
          "type": "integer"
        },
        "update_rule_id": {
          "type": "string"
        }
      }
    },
    "outputs": {
      "type": "object",
      "required": [
        "event_log_path",
        "summary_path",
        "run_checksums_path"
      ],
      "properties": {
        "event_log_path": {
          "type": "string"
        },
        "signal_log_path": {
          "type": "string"
        },
        "summary_path": {
          "type": "string"
        },
        "run_checksums_path": {
          "type": "string"
        }
      }
    }
  },
  "additionalProperties": true
}