\section{Appendix D: Finite-Difference Bulk Modulus and \texorpdfstring{$c=\sqrt{B/\rho}$}{c=sqrt(B/rho)}}
% ============================================================

\begin{lstlisting}[language=Python,caption={Static bulk modulus B from energy FD + c=sqrt(B/rho) (no scaling-factor fit)}]
import math
import numpy as np

# Requires the functions from Appendix C: compute_energy_forces, fire_minimize, etc.

def bulk_modulus_energy_fd(pos0, L0, eps=1e-4):
    # assumes pos0 is minimized at L0
    E0, _, _, _ = compute_energy_forces(pos0, L0)
    u0 = E0 / (L0**3)

    # +eps
    Lp = L0 * (1 + eps)
    posp = (pos0 * (Lp / L0)) % Lp
    posp, Ep, *_ = fire_minimize(posp, Lp)
    up = Ep / (Lp**3)

    # -eps
    Lm = L0 * (1 - eps)
    posm = (pos0 * (Lm / L0)) % Lm
    posm, Em, *_ = fire_minimize(posm, Lm)
    um = Em / (Lm**3)

    B = (up + um - 2*u0) / (9 * eps**2)
    return float(B)

if __name__ == "__main__":
    N = 64
    seed = 1
    phiJ, width, posJ, LJ = find_phiJ_bisect(N=N, seed=seed, n_bisect=6)

    B = bulk_modulus_energy_fd(posJ, LJ, eps=1e-4)
    rho = N / (LJ**3)  # mass=1 per particle (unit choice)

    c = math.sqrt(max(B,0.0) / rho)
    print("phiJ(est):", phiJ, "B:", B, "rho:", rho, "c:", c)
\end{lstlisting}

