\section{FCC Dispersion: Perfect Linearity Emerges at Long Wavelength}
% ============================================================

This section documents the FCC dispersion simulation with a numerically stable ``half-angle'' evaluation and its analytic interpretation.

\subsection{FCC neighbor set}
Use the 12 nearest neighbors of FCC (normalized to length $\aL$). In the simulation we set $\aL=1$:
\[
\evec\in \frac{1}{\sqrt{2}}\{(\pm1,\pm1,0),(\pm1,0,\pm1),(0,\pm1,\pm1)\}.
\]

\subsection{Exact small-$k$ isotropy (2nd moment)}
For this neighbor set (with $|\evec|=1$), one can show
\[
\sum_{\evec}\evec\evec^{\mathsf T}=4\I.
\]
Hence for small $K=|\Kvec|$,
\[
\omega^2(\Kvec)=\frac{k}{m}\cdot \frac12\Kvec^{\mathsf T}(4\I)\Kvec + O(K^4)
= \frac{k}{m}\cdot 2K^2 + O(K^4).
\]
Therefore the long-wavelength speed is
\begin{equation}
\boxed{\;c_0=\sqrt{2}\sqrt{\frac{k}{m}}\qquad (\text{FCC, } \aL=1).\;}
\end{equation}
In the code we set $k/m=1$ (unit convention), so $c_0=\sqrt{2}$.

\subsection{Leading dispersion error: \texorpdfstring{$\mathcal{O}(K^2)$}{O(K^2)} and analytic prefactor}
Using the identity
\[
2\sin^2(\theta/2)=\frac{\theta^2}{2}-\frac{\theta^4}{24}+O(\theta^6),
\]
we obtain
\begin{align}
\omega^2(\Kvec)
&= \frac{k}{m}\sum_{\evec}\left[\frac{(\Kvec\cdot\evec)^2}{2}-\frac{(\Kvec\cdot\evec)^4}{24}+O(K^6)\right]\\
&= \frac{k}{m}\left[2K^2 - \frac{1}{24}\sum_{\evec}(\Kvec\cdot\evec)^4 + O(K^6)\right].
\end{align}
Hence the \emph{normalized} speed $v=\omega/K$ obeys
\begin{equation}
\frac{v(\hat{\Kvec})}{c_0}
=
1-\frac{K^2}{96}\sum_{\evec}(\hat{\Kvec}\cdot\evec)^4 + O(K^4).
\label{eq:dv_over_c}
\end{equation}
Therefore the speed deviation scales as
\[
\left|\frac{\Delta c}{c}\right| \sim \beta(\hat{\Kvec}) K^2 \sim \mathcal{O}\!\left(\frac{1}{\tilde\lambda^2}\right),
\qquad \tilde\lambda\equiv \frac{\lambda}{\aL}\gg1.
\]

\paragraph{Max direction and closed-form coefficient.}
The worst direction is $\langle 111\rangle$. One finds
\[
\sum_{\evec} (\hat{\Kvec}\cdot\evec)^4\Big|_{111}=\frac{8}{3}.
\]
Thus from \eqref{eq:dv_over_c},
\[
\left|\frac{\Delta c}{c}\right|_{111}\approx \frac{K^2}{96}\cdot\frac{8}{3}=\frac{K^2}{36}.
\]
Since $K=2\pi/\lambda = 2\pi/(\tilde\lambda\,\aL)$ and we measure $\lambda$ in units of $\aL$,
\begin{equation}
\boxed{\;
\left|\frac{\Delta c}{c}\right|_{\max}
\approx \frac{\pi^2}{9}\frac{1}{\tilde\lambda^2}
\qquad (\tilde\lambda\gg 1,\ \text{FCC, nearest neighbors}).\;}
\end{equation}

\subsection{Numerical stabilization: half-angle identity}
For very small angles $\theta$, floating-point evaluation of $\cos\theta -1$ suffers catastrophic cancellation.
Use the identity
\[
\cos\theta-1 = -2\sin^2(\theta/2),
\]
which preserves precision for $\theta\to 0$. This was implemented in the ``Ultra-Precision'' code below.

