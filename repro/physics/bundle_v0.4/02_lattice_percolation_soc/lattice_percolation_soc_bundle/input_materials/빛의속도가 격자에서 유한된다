\section{Appendix A: Legacy Heuristic RCP Density Code (User's Growth Algorithm)}
% ============================================================

\paragraph{Purpose.}
This is the earlier heuristic ``random growth'' algorithm for estimating RCP density. It is not a full MD/DEM solver, but it was part of the development record.

\begin{lstlisting}[language=Python,caption={Legacy heuristic RCP density estimator (random growth + overlap relax)}]
import numpy as np
from scipy.spatial.distance import pdist, squareform

def simulate_rcp_density(n_particles=500, n_steps=2000, growth_rate=0.001):
    """
    Heuristic RCP density estimate via random particle growth + overlap relaxation.
    NOTE: not a production-grade DEM/MD solver; intended for qualitative behavior.
    """
    L = 1.0
    positions = np.random.rand(n_particles, 3) * L
    radius = 0.01

    print(f"--- Simulation start (N={n_particles}) ---")

    for step in range(n_steps):
        radius *= (1 + growth_rate)

        dx = np.abs(positions[:, np.newaxis, :] - positions[np.newaxis, :, :])
        dx = np.where(dx > 0.5 * L, L - dx, dx)  # periodic BC
        dists = np.sqrt(np.sum(dx**2, axis=2))

        np.fill_diagonal(dists, np.inf)
        overlaps = dists < (2 * radius)

        if np.any(overlaps):
            move_idx = np.any(overlaps, axis=1)
            positions[move_idx] += (np.random.rand(np.sum(move_idx), 3) - 0.5) * radius * 0.1
            positions = positions % L
            radius /= (1 + growth_rate * 0.5)

        vol_particles = n_particles * (4/3) * np.pi * (radius**3)
        density = vol_particles / (L**3)

        if step % 200 == 0:
            print(f"Step {step}: phi = {density:.4f}")

        if step > 500 and density > 0.55 and growth_rate > 1e-5:
            growth_rate *= 0.99

    return density

final_phi = simulate_rcp_density(n_particles=300, n_steps=3000)
print(f"[Final] phi={final_phi:.4f}, void fraction={1-final_phi:.4f}")
\end{lstlisting}

