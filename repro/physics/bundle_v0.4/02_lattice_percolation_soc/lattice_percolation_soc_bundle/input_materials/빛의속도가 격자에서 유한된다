\section{Appendix C: RCP / Point-J (Soft Spheres + FIRE + Bisection, No Tuning)}
% ============================================================

\begin{lstlisting}[language=Python,caption={RCP/Point-J: FIRE minimization + bisection for phi_J + Z and isotropy Q (no fit)}]
import numpy as np
import math

def compute_energy_forces(pos, L, diameter=1.0, k_spring=1.0):
    # periodic minimum image
    dr = pos[:, None, :] - pos[None, :, :]
    dr -= L * np.round(dr / L)
    dist = np.linalg.norm(dr, axis=2)
    np.fill_diagonal(dist, np.inf)

    mask = dist < diameter
    overlap = np.where(mask, diameter - dist, 0.0)

    # total energy U = sum_{i<j} 0.5 k overlap^2
    E = 0.25 * k_spring * np.sum(overlap**2)

    invdist = np.where(mask, 1.0 / dist, 0.0)
    forces = np.sum((k_spring * overlap * invdist)[:, :, None] * dr, axis=1)

    max_f = float(np.max(np.linalg.norm(forces, axis=1)))
    max_ov = float(np.max(overlap)) if overlap.size else 0.0
    return float(E), forces, max_f, max_ov

def fire_minimize(pos, L, max_iter=9000, f_tol=1e-11, dt0=0.01, dt_max=0.1, alpha0=0.1):
    pos = pos.copy()
    v = np.zeros_like(pos)
    dt, alpha = dt0, alpha0
    n_pos = 0

    for it in range(max_iter):
        E, f, fmax, ovmax = compute_energy_forces(pos, L)
        if fmax < f_tol:
            return pos, E, fmax, ovmax, it

        v += dt * f
        P = float(np.sum(v * f))
        f_norm = float(np.linalg.norm(f))
        v_norm = float(np.linalg.norm(v))
        if f_norm == 0.0:
            return pos, E, fmax, ovmax, it

        if P > 0:
            n_pos += 1
            if n_pos > 5:
                dt = min(dt * 1.1, dt_max)
                alpha *= 0.99
        else:
            n_pos = 0
            dt *= 0.5
            v[:] = 0.0
            alpha = alpha0

        v = (1 - alpha) * v + alpha * (v_norm / f_norm) * f
        pos = (pos + dt * v) % L

    E, f, fmax, ovmax = compute_energy_forces(pos, L)
    return pos, E, fmax, ovmax, max_iter

def box_length_from_phi(N, phi, diameter=1.0):
    V_sphere = math.pi / 6.0 * diameter**3
    V = N * V_sphere / phi
    return V**(1/3)

def is_jammed(E, max_overlap):
    # numerical (not fitted): unjammed minima have overlap->0, energy->0
    return (max_overlap > 1e-8) or (E > 1e-14)

def contact_stats(pos, L, diameter=1.0):
    dr = pos[:, None, :] - pos[None, :, :]
    dr -= L * np.round(dr / L)
    dist = np.linalg.norm(dr, axis=2)
    np.fill_diagonal(dist, np.inf)

    contact = dist < diameter
    iu = np.triu_indices(len(pos), k=1)
    cont_u = contact[iu]
    M = int(np.sum(cont_u))
    Z = 2.0 * M / len(pos)

    Q = np.zeros((3,3))
    if M > 0:
        dr_u = dr[iu][cont_u]
        dist_u = dist[iu][cont_u]
        u = dr_u / dist_u[:, None]
        Q = (u[:, :, None] * u[:, None, :]).mean(axis=0)
    return Z, M, Q

def contact_graph(pos, L, diameter=1.0):
    dr = pos[:, None, :] - pos[None, :, :]
    dr -= L * np.round(dr / L)
    dist = np.linalg.norm(dr, axis=2)
    np.fill_diagonal(dist, np.inf)
    return dist < diameter

def Z_backbone(contact_mat):
    # remove rattlers with degree <=3 iteratively (3D)
    N = contact_mat.shape[0]
    active = np.ones(N, dtype=bool)
    changed = True
    while changed:
        changed = False
        deg = contact_mat[active][:, active].sum(axis=1)
        to_remove = deg <= 3
        if np.any(to_remove):
            idx = np.where(active)[0]
            active[idx[to_remove]] = False
            changed = True

    if active.sum() == 0:
        return 0.0, 0

    sub = contact_mat[active][:, active]
    iu = np.triu_indices(sub.shape[0], k=1)
    M = int(np.sum(sub[iu]))
    Z = 2.0 * M / sub.shape[0]
    return float(Z), int(active.sum())

def find_phiJ_bisect(N=64, seed=0, phi_lo=0.50, phi_hi=0.74, n_bisect=6):
    rng = np.random.default_rng(seed)

    # Unjam start
    L_lo = box_length_from_phi(N, phi_lo)
    for _ in range(10):
        pos_lo = rng.random((N,3)) * L_lo
        pos_lo, E, fmax, ovmax, _ = fire_minimize(pos_lo, L_lo)
        if not is_jammed(E, ovmax):
            break
    assert not is_jammed(E, ovmax)

    # Jam high
    L_hi = box_length_from_phi(N, phi_hi)
    pos_hi = (pos_lo * (L_hi / L_lo)) % L_hi
    pos_hi, E, fmax, ovmax, _ = fire_minimize(pos_hi, L_hi)
    assert is_jammed(E, ovmax)

    # Bisection
    for _ in range(n_bisect):
        phi_mid = 0.5*(phi_lo + phi_hi)
        Lm = box_length_from_phi(N, phi_mid)
        posm = (pos_lo * (Lm / L_lo)) % Lm
        posm, E, fmax, ovmax, _ = fire_minimize(posm, Lm)
        if is_jammed(E, ovmax):
            phi_hi, pos_hi, L_hi = phi_mid, posm, Lm
        else:
            phi_lo, pos_lo, L_lo = phi_mid, posm, Lm

    return 0.5*(phi_lo+phi_hi), (phi_hi-phi_lo), pos_hi, L_hi

if __name__ == "__main__":
    N = 64
    for seed in [0,1]:
        phiJ, width, posJ, LJ = find_phiJ_bisect(N=N, seed=seed, n_bisect=6)
        Z_all, M, Q = contact_stats(posJ, LJ)
        Zbb, Nbb = Z_backbone(contact_graph(posJ, LJ))
        eig = np.linalg.eigvalsh(Q)
        dev = np.linalg.norm(Q - np.eye(3)/3.0, ord='fro')
        print("seed", seed, "phiJ", phiJ, "width", width,
              "Z_all", Z_all, "Z_bb", Zbb, "Gamma", Zbb/6.0,
              "Q_eigs", eig, "Q_dev", dev)
\end{lstlisting}

