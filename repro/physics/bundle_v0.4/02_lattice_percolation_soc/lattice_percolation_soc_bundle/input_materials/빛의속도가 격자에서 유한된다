\begin{equation}
\C^2
=\GammaS\,\frac{\Szero\,\aL}{\rhozero\,\aL^3}\,\aL^2
=\GammaS\,\frac{\Szero}{\rhozero}.
\end{equation}
Thus $\aL$ cancels \emph{exactly}.

\paragraph{Point-J specialization.}
At Point-J, $\GammaS_J=1$ (Section~\ref{eq:Gamma1}), hence
\begin{equation}
\boxed{\;\C^2=\frac{\Szero}{\rhozero}\;}
